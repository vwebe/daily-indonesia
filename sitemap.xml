---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url | append: site.baseurl }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>hourly</changefreq>
    <priority>1.0</priority>
  </url>
{% assign sitemap_pages = site.pages | where_exp: "page", "page.sitemap != false" | sort: "url" %}
{% for page in sitemap_pages %}
{% unless page.url == "/" or page.url contains "/404.html" or page.url contains "/sitemap.xml" or page.url contains "/robots.txt" or page.url contains "/feed.xml" %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    <lastmod>{% if page.last_modified_at %}{{ page.last_modified_at | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
{% endunless %}
{% endfor %}
{% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{% if post.last_modified_at %}{{ post.last_modified_at | date_to_xmlschema }}{% else %}{{ post.date | date_to_xmlschema }}{% endif %}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
{% endfor %}
</urlset>
